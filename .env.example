# ============================================================
# RLAI Tech Evaluation Platform - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in all values

# ─── Database (Azure Database for PostgreSQL) ───────────────
DATABASE_URL="postgresql://USERNAME:PASSWORD@SERVER.postgres.database.azure.com:5432/rlai_eval?sslmode=require"

# ─── NextAuth ───────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Admin Setup ────────────────────────────────────────────
# Email/password for the first admin account
ADMIN_EMAIL="admin@rightleft.ai"
ADMIN_PASSWORD="change-this-strong-password"

# ─── Azure Blob Storage ─────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=KEY;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_RESUMES="rlai-resumes"
AZURE_STORAGE_CONTAINER_DIAGRAMS="rlai-diagrams"

# ─── Anthropic Claude API ────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ─── Email (SMTP for HR notifications) ──────────────────────
# Option 1: SMTP (Gmail, Outlook, Azure Communication Services)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="RLAI Talent <no-reply@rightleft.ai>"

# Option 2: SendGrid (uncomment and use instead)
# SENDGRID_API_KEY="SG...."

# ─── HR Notification ─────────────────────────────────────────
HR_EMAIL="hr@rightleft.ai"
HR_CC_EMAIL="talent@rightleft.ai"

# ─── App Settings ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="RLAI Tech Evaluation"
